{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "words.json",
  "type": "object",
  "required": [
    "version",
    "audio",
    "duration",
    "words"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "const": 1
    },
    "audio": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Seconds, measured on narration.wav"
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "i",
          "token",
          "display",
          "start",
          "end"
        ],
        "properties": {
          "i": {
            "type": "integer",
            "minimum": 0,
            "description": "Position in the list"
          },
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "What was spoken"
          },
          "display": {
            "type": "string",
            "minLength": 1,
            "description": "Exactly what the caption shows"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "sentence": {
            "type": "integer",
            "minimum": 0
          },
          "speaker": {
            "type": "string",
            "minLength": 1,
            "description": "Who speaks the word; \"narrator\" for a single voice"
          }
        }
      }
    }
  }
}
